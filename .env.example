# Copy to .env and fill in. Never commit .env.
# The only model gateway: every model call (pipeline and explorations) goes through OpenRouter.
OPENROUTER_API_KEY=

# Experiment tracking (local self-hosted Langfuse; its compose maps the web UI to port 3020)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3020

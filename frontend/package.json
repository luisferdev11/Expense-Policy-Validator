{
  "name": "epv-frontend",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "styles": "node scripts/build-styles.mjs",
    "evaluation": "node scripts/build-evaluation.mjs",
    "gen:api": "openapi-typescript ../docs/api/openapi.json -o src/api/generated.ts",
    "predev": "npm run styles",
    "dev": "vite",
    "prebuild": "npm run styles",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "npm run styles",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
